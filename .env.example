# Shared password for the admin login screen
ADMIN_PASSWORD=change-me
# Long random string used to sign the login cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=replace-with-a-long-random-string

# Supabase Postgres — use the "Transaction pooler" connection string
# (Supabase dashboard > Connect > Transaction pooler), port 6543. Tables are created automatically.
# Leave empty for local development: designs are then saved in the .data/ folder.
DATABASE_URL=

# Gmail account that sends the certificates + a Google App Password
# (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=rit.ecertificate@gmail.com
GMAIL_APP_PASSWORD=
# Display name on outgoing emails
MAIL_FROM_NAME=Rajalakshmi Institute of Technology
